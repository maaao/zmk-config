// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        addr: addr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp Y &kp A &kp M &kp A &kp M &kp O &kp T &kp O &kp DOT &kp M &kp A &kp O &kp AT &kp J &kp P &kp DOT &kp F &kp U &kp J &kp I &kp T &kp S &kp U &kp DOT &kp C &kp O &kp M>;
        };

        admin1: admin1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp LS(A) &kp D &kp M &kp I &kp N &kp MINUS &kp LS(M) &kp A &kp S &kp T &kp E &kp R>;
        };

        admin2: admin2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp LS(A) &kp D &kp M &kp I &kp N &kp LS(FSLH) &kp LS(M) &kp A &kp S &kp T &kp E &kp R &kp N1>;
        };

        yama: yama {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N0 &kp N9 &kp Y &kp A &kp M &kp A &kp N2 &kp N7>;
        };

        mao: mao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N0 &kp N9 &kp M &kp A &kp O &kp N2 &kp N7 &kp LS(FSLH) &kp N0 &kp N0>;
        };

        gro: gro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp LS(R) &kp S &kp LS(Y) &kp LS(A) &kp LS(FSLH) &kp LS(T) &kp LS(L) &kp RPRN &kp N4 &kp LS(X)>;
        };

        proxy: proxy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N3 &kp N1 &kp N4 &kp N1 &kp N5 &kp N9 &kp N2>;
        };

        bios: bios {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp M &kp Z &kp N2 &kp Y &kp H &kp Y &kp S &kp N5>;
        };

        n2_us: n2_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n6_us: n6_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n7_us: n7_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LS(N6)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n8_us: n8_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp LS(SQT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n9_us: n9_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LS(N8)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n0_us: n0_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        semi_us: semi_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqt_us: sqt_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(N2)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbrc_us: lbrc_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp LS(RBKT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rbrc_us: rbrc_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp LS(BSLH)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_us: minus_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bslh_us: bslh_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT3>, <&kp LS(INT3)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC      &kp N1       &n2_us       &kp N3       &kp N4       &kp N5                                 &n6_us       &n7_us       &n8_us       &n9_us       &n0_us       &kp DEL
                &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                                  &kp Y        &kp U        &kp I        &kp O        &kp P        &minus_us
                &kp LSHFT    &kp A        &kp S        &kp D        &kp F        &kp G                                  &kp H        &kp J        &kp K        &kp L        &semi_us     &sqt_us
                &kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B      &lbrc_us        &rbrc_us    &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &bslh_us
                                                       &kp LGUI     &mo 1        &kp LALT   &kp ENTER       &kp SPACE   &kp BSPC                                            &mo 2        &studio_unlock
            >;
        };

        layer1 {
            bindings = <
                &kp GRAVE    &admin1      &addr        &mao         &proxy       &yama                                  &trans       &trans       &trans       &trans       &trans       &trans
                //&trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                                 &trans       &trans       &trans       &trans       &trans       &trans
                //&trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &mkp MB4     &mkp RCLK    &trans       &mkp LCLK    &trans                                 &trans       &kp LEFT     &kp UP       &kp DOWN     &kp RIGHT    &trans
                //&trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                                                       &trans       &trans       &trans       &trans       &trans       &trans                                              &trans       &trans
            >;
        };

        layer2 {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR_ALL                         &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans                                 &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
                &trans       &trans       &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                                                       &trans       &trans       &trans       &trans       &trans       &trans                                              &trans       &trans
            >;
        };

        layer3 {
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &mkp MCLK    &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                //&trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                                                       &trans       &trans       &trans       &trans       &trans       &trans                                              &trans       &trans
            >;
        };

    };
};
